import PcsQuotient.Reduction

/-!
# The statement's rows' polynomial at `2^22` rows, by kernel evaluation

`PcsQuotient.Domain.rowVanishing 24` (`τ`, the Gauss–Jordan solution of `22` equations over `K`) computed
by the kernel one elimination step at a time: the `23` intermediate matrices are written out
(`tauMat k`, the rows after `k` steps, as words; they were printed by compiled evaluation of the
statement's own `eliminate`), and each step `eliminate 22 (mat (tauMat k)) k = mat (tauMat (k + 1))` is
checked by `decide +kernel` (about ten seconds each). Evaluating `rowVanishing 24` in one go exhausts
the kernel's memory (16 GB).
-/

namespace Bridge.Claims

open LeanVM.Parameters PcsQuotient.Domain

/-- A matrix of `K` from its words. -/
def mat (L : List (List ℕ)) : Array (Array K) :=
  (L.map fun r ↦ (r.map fun x ↦ K.ofLane x.toUInt64).toArray).toArray

/-- The system `rowVanishing 24` solves: one row per `β_j`, `2 ≤ j < 24`, `w_k(β_j) = β_{j−k}`. -/
def tauRows : Array (Array K) :=
  Array.ofFn (n := 22) fun r ↦
    Array.ofFn (n := 22 + 1) fun k ↦ if k.val ≤ r.val + 2 then betaAt (r.val + 2 - k.val) else 0

