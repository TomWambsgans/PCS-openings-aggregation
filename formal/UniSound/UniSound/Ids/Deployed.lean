import UniSound.Ids.Bridges
import Bridge.Claims.Constants
import Bridge.Ntt

/-!
# The deployment's constants (`Bridges.lean`'s `BetaCantor`, `FunctionalsCorrect`, `LayoutAligned`,
`C1Limbs`, `SetupLimbs`, `HeapGood`, `BasisValueInv`)

* **The basis** (`betaCantor`): the verifier's `beta` (`UniStatement.Domain`, `32` vectors) is, as words,
  F0c's `betaWords` then eight more (`beta_lanes`, kernel evaluation of its pivots and solves, a few
  seconds), so its first `24` vectors are `QuotientSecurity.deployedBasis`'s (`beta_lanes24`), whose
  `S(β_{k+1}) = β_k` the kernel checked; they are the statement's (`beta_eq_betaAt`), so the verifier's
  points are the statement's below `2^24` (`point_eq_domain`).
* **The coordinate functionals at height `18`** (`functionalsCorrect18`): `coordinateFunctionals` is its
  Gauss–Jordan steps (`cf_eq`, every `r`); at `18` the kernel checks each step from the previous rows
  as words, and then that the result inverts the Moore matrix.
* **The stack layouts** (`layoutAligned_new`, for any columns): `StackLayout.new` lays its pieces end to
  end sorted largest first (`List.pairwise_mergeSort`), so each offset is a sum of larger powers of two
  and the stack's `max (⌈log₂ offset⌉) 15` variables hold them all. A column listed once, `K`-valued,
  is one limb (`limbs_new_single`, by `mergeSort`'s permutation: no evaluation of the sort); so
  **`C1`'s and the setup's columns at the reference shape** (`c1Limbs_reference`, `setupLimbs_reference`),
  the column lists' filters being checked by the kernel.
* **The heap at the reference shape** (`heapGood_reference`): its used blocks sorted are the explicit list
  (`List.Perm.eq_of_pairwise`: `mergeSort`'s order is a total preorder, antisymmetric on these blocks),
  then the kernel lays them out (`8` used blocks and one unused).
* **The basis-`B` inverse** (`basisValueInv`, for every `r ≤ 24`): `basisValue c r x` is the multilinear
  extension `Σ_k c_k Π_l (k_l ? w_l : 1 + w_l)` at the digits `w_l = S^l(ω_x)` (`mleK_eq`,
  `point_eq_domain`, `Bridge.Ntt.iterate_point`); each subset-sum stage turns one factor into the novel
  basis's (`stage_sum`: `1 + w + w = 1` in characteristic two), so `subsetSums` of the novel-basis
  coefficients is the novel-basis polynomial `Σ_j X_j(ω_x) d_j`, which is `v_x`
  (`Bridge.Ntt.values_getD_K`, `values_coefficients_K`).
-/

namespace UniSound.Ids

open LeanVM.Parameters UniStatement Finset

/-! ## The verifier's basis (`BetaCantor`) -/

/-- **The verifier's basis, as words**: F0c's `betaWords` (the first `24`, which the deployment reads),
then eight more (by kernel evaluation of the verifier's pivots and solves). -/
theorem beta_lanes : beta.toList.map K.lane = QuotientSecurity.betaWords ++
    [17912355520934743958, 6218866736850678610, 12480526167760891192, 6314909037432299316,
      12751101101690848154, 16952366619910512524, 6117505913754744912, 13143866455446828242] := by
  decide +kernel

theorem array_getD_toList (a : Array K) (k : ℕ) : a.getD k 0 = a.toList.getD k 0 := by
  rw [Array.getD_eq_getD_getElem?, List.getD_eq_getElem?_getD, Array.getElem?_toList]

/-- **`β_k`, `k < 24`, is F0c's deployed basis vector** (`QuotientSecurity.betaF64`). -/
theorem beta_lanes24 : ∀ k < 24, beta.getD k 0 = QuotientSecurity.betaF64 k := by
  intro k hk
  rw [array_getD_toList, Bridge.getD_of_words beta_lanes,
    List.getD_append _ _ _ _ (show k < QuotientSecurity.betaWords.length by
      rw [show QuotientSecurity.betaWords.length = 24 from rfl]; omega)]
  rfl

/-- **The verifier's basis is Cantor** on its first `24` vectors. -/
theorem betaCantor : BetaCantor := by
  refine ⟨?_, fun k hk ↦ ?_⟩
  · rw [beta_lanes24 0 (by norm_num)]
    rfl
  · rw [beta_lanes24 (k + 1) hk, beta_lanes24 k (by omega)]
    exact QuotientSecurity.betaF64_succ ⟨k, by omega⟩

/-- **`β_k`, `k < 24`, is the statement's** (`PcsQuotient.Domain.betaAt`): both are F0c's words. -/
theorem beta_eq_betaAt : ∀ k < 24, beta.getD k 0 = PcsQuotient.Domain.betaAt k := fun k hk ↦ by
  rw [beta_lanes24 k hk, Bridge.betaAt_eq_deployedBasis k hk]
  rfl

/-- The statement's first `r ≤ 24` basis vectors are a Cantor basis (`Bridge.Ntt.CantorUpTo`). -/
theorem cantorUpTo_le {r : ℕ} (hr : r ≤ 24) : Bridge.Ntt.CantorUpTo r := by
  refine ⟨?_, fun k hk ↦ ?_⟩
  · rw [Bridge.betaAt_eq_deployedBasis 0 (by norm_num)]
    exact QuotientSecurity.deployedBasis.zero
  · rw [Bridge.betaAt_eq_deployedBasis (k + 1) (by omega), Bridge.betaAt_eq_deployedBasis k (by omega)]
    exact QuotientSecurity.deployedBasis.succ k (by omega)

theorem foldl_point_uni (n : ℕ) : ∀ N : ℕ,
    (List.range N).foldl (fun acc k ↦ if n.testBit k then acc + beta.getD k 0 else acc) 0 =
      ∑ t ∈ range N, if n.testBit t then beta.getD t 0 else 0
  | 0 => by simp
  | N + 1 => by
    rw [List.range_succ, List.foldl_append, foldl_point_uni n N, Finset.sum_range_succ]
    simp only [List.foldl_cons, List.foldl_nil]
    split_ifs <;> simp

/-- **The verifier's points are the statement's** below `2^24`: `ω_n = B(n)`. -/
theorem point_eq_domain {n : ℕ} (hn : n < 2 ^ 24) : point n = PcsQuotient.Domain.point n := by
  rw [Bridge.Ntt.point_eq_sum_of_lt (N := 24) (by decide) hn, point, foldl_point_uni,
    show basisSize = 24 + 8 from rfl, Finset.sum_range_add]
  have z : ∑ x ∈ range 8, (if n.testBit (24 + x) then beta.getD (24 + x) 0 else 0) = 0 :=
    Finset.sum_eq_zero fun t _ ↦ by
      rw [Nat.testBit_eq_false_of_lt (lt_of_lt_of_le hn (Nat.pow_le_pow_right (by norm_num) (by omega)))]
      simp
  rw [z, add_zero]
  refine Finset.sum_congr rfl fun t ht ↦ ?_
  rw [beta_eq_betaAt t (Finset.mem_range.mp ht)]

/-! ## The coordinate functionals at height `18` (`FunctionalsCorrect 18`)

`coordinateFunctionals r` is `r` Gauss–Jordan steps on `[M | I]` (`cfInit`, `cfStep`), then the right
half read transposed (`cfFinal`); `cf_eq` says so for every `r`. At `r = 18` the kernel checks each step
from the previous rows as words (`cfMat k`, printed by compiled evaluation of `cfStep`): about thirteen
seconds a step (three steps at once take sixteen gigabytes). Then `cfA` (the functionals' words) times
`M` (`cfMat0`'s left half, `M[k][m] = β_k^(2^m)`) is the identity, row by row. -/

/-- `[M | I]`, `M[j][m] = β_j^(2^m)` (`coordinateFunctionals`'s first `rows`). -/
def cfInit (r : ℕ) : Array (Array K) := Array.ofFn (n := r) fun j ↦
    (Array.ofFn (n := r) fun mm ↦ frobK (beta.getD j.val 0) mm.val) ++
      Array.ofFn (n := r) fun c ↦ if c.val = j.val then (1 : K) else 0

/-- One Gauss–Jordan step on column `col` (`coordinateFunctionals`'s loop body). -/
def cfStep (r : ℕ) (rows : Array (Array K)) (col : ℕ) : Array (Array K) := Id.run do
    let mut rows := rows
    let pivot := ((List.range' col (r - col)).find? fun i ↦
      (rows.getD i #[]).getD col 0 ≠ 0).getD col
    let rowCol := rows.getD col #[]
    let rowPivot := rows.getD pivot #[]
    rows := (rows.set! col rowPivot).set! pivot rowCol
    let inverse := ((rows.getD col #[]).getD col 0)⁻¹
    rows := rows.set! col ((rows.getD col #[]).map (· * inverse))
    for i in [0:r] do
      let factor := (rows.getD i #[]).getD col 0
      if i ≠ col ∧ factor ≠ 0 then
        let pivotRow := rows.getD col #[]
        rows := rows.set! i ((rows.getD i #[]).zipWith (fun x p ↦ x + factor * p) pivotRow)
    return rows

/-- The functionals read off the reduced rows (`coordinateFunctionals`'s result). -/
def cfFinal (r : ℕ) (rows : Array (Array K)) : Array (Array K) :=
  Array.ofFn (n := r) fun l ↦ Array.ofFn (n := r) fun mm ↦ (rows.getD mm.val #[]).getD (r + l.val) 0

theorem forIn_id_eq_foldl {α β : Type} (l : List α) (init : β) (f : α → β → Id (ForInStep β))
    (g : β → α → β) (h : ∀ a b, f a b = pure (.yield (g b a))) :
    forIn l init f = pure (l.foldl g init) := by
  rw [show f = fun a b ↦ pure (.yield (g b a)) from funext fun a ↦ funext fun b ↦ h a b]
  exact List.forIn_pure_yield_eq_foldl _ _

/-- **`coordinateFunctionals` is its steps**, for every `r`. -/
theorem cf_eq (r : ℕ) :
    coordinateFunctionals r = cfFinal r ((List.range r).foldl (cfStep r) (cfInit r)) := by
  unfold coordinateFunctionals
  dsimp only
  rw [Std.Legacy.Range.forIn_eq_forIn_range', forIn_id_eq_foldl (g := cfStep r)]
  · simp [List.range_eq_range', Std.Legacy.Range.size, cfFinal, cfInit]
  · intro _ _
    rfl

/-- `cfInit`'s left half: `M[k][m] = β_k^(2^m)`. -/
theorem cfInit_getD {r k m : ℕ} (hk : k < r) (hm : m < r) :
    ((cfInit r).getD k #[]).getD m 0 = frobK (beta.getD k 0) m := by
  simp [cfInit, Array.getD_eq_getD_getElem?, Array.getElem?_append, hk, hm]

/-- A matrix of `K` from its words. -/
def mat (L : List (List ℕ)) : Array (Array K) :=
  (L.map fun r ↦ (r.map fun x ↦ K.ofLane x.toUInt64).toArray).toArray

/-- Row `l` of `A` against row `k` of `M`, over the first `18` columns. -/
def cfDot (A M : List (List ℕ)) (l k : ℕ) : K :=
  ((List.range 18).map fun m ↦ ((mat A).getD l #[]).getD m 0 * ((mat M).getD k #[]).getD m 0).sum

