/-- `k + 1` steps from `[M | I]`. -/
theorem cfFold_succ (k : ℕ) : (List.range (k + 1)).foldl (cfStep 18) (cfInit 18) =
    cfStep 18 ((List.range k).foldl (cfStep 18) (cfInit 18)) k := by
  rw [List.range_succ, List.foldl_append, List.foldl_cons, List.foldl_nil]

theorem cfFold0 : (List.range 0).foldl (cfStep 18) (cfInit 18) = mat cfMat0 := cfInit_eq

theorem cfFold1 : (List.range 1).foldl (cfStep 18) (cfInit 18) = mat cfMat1 :=
  (cfFold_succ 0).trans ((congrArg (cfStep 18 · 0) cfFold0).trans cfStep0)

theorem cfFold2 : (List.range 2).foldl (cfStep 18) (cfInit 18) = mat cfMat2 :=
  (cfFold_succ 1).trans ((congrArg (cfStep 18 · 1) cfFold1).trans cfStep1)

theorem cfFold3 : (List.range 3).foldl (cfStep 18) (cfInit 18) = mat cfMat3 :=
  (cfFold_succ 2).trans ((congrArg (cfStep 18 · 2) cfFold2).trans cfStep2)

theorem cfFold4 : (List.range 4).foldl (cfStep 18) (cfInit 18) = mat cfMat4 :=
  (cfFold_succ 3).trans ((congrArg (cfStep 18 · 3) cfFold3).trans cfStep3)

theorem cfFold5 : (List.range 5).foldl (cfStep 18) (cfInit 18) = mat cfMat5 :=
  (cfFold_succ 4).trans ((congrArg (cfStep 18 · 4) cfFold4).trans cfStep4)

theorem cfFold6 : (List.range 6).foldl (cfStep 18) (cfInit 18) = mat cfMat6 :=
