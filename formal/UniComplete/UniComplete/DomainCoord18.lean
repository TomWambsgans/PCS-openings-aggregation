import UniComplete.DomainCoord

/-!
# The coordinate functionals at the reference height `r = 18` (milestone 4, the domain facts)

`CoordinateFunctionalsBasis 18` (`DomainCoord`), by kernel evaluation on literal words, so that
`coordinatesAt (ω_i) (coordinateFunctionals 18)` is the bit vector of `i` for every `i < 2^18`
(`coordinatesAt_pointE_18`).

One `decide +kernel` of `coordinateFunctionals 18` does not finish (the elimination's entries stay unevaluated
terms that the kernel re-reads: more than 30 minutes and 10 GB). So:

* **The elimination as a fold** (`coordinateFunctionals_eq_gjSteps`): `coordinateFunctionals r` is `gjOut r` of
  the fold of `gjStep r col` over the columns `0 … r − 1` from `gjInit r`; `gjStep` is the loop's body verbatim,
  and the equation holds by `rfl` on it.
* **Kernel-friendly products** (`mulF`, `invF`): the kernel evaluates CompPoly's product in `K` (a carry-less
  product looped by `Fin.foldl`, a well-founded recursion, on `BitVec`s) in about 45 ms; `mulF` is the same
  carry-less product and reduction on natural numbers (`clmulN`, `foldN`, `mulN`: `List.range` loops of the
  kernel's accelerated `Nat` operations), skipping the factors `0` and `1`, and `mulF_eq : mulF a b = a * b`
  (from `clmul_toNat`, `foldStep_toNat`: the `BitVec` loop is the `Nat` loop); `invF` is CompPoly's Itoh–Tsujii
  chain on `mulF` (`invF_eq`). The column steps, the start matrix and the check are restated on them
  (`gjStepF`, `gjInitF`, `coordinatesAtKF`), each equal to the original by rewriting.
* **The literal matrices** `gjW0 … gjW18`: `[M | I]` before and after each group of columns, as words, generated
  once by a Python reimplementation of the Lean code (the same pivot rule and row order; a certificate, not
  trusted: each group is checked by the kernel, `gjInit_words`, `gjSteps_c`), chained by rewriting into
  `coordinateFunctionals_18 : coordinateFunctionals 18 = gjOut 18 (ofWords gjW18)`.
* **The basis values** `y_l(β_j) = [l = j]` on the literal matrix, in `K` (`coordinatesAt_ofK`:
  `coordinatesAt (ofK t) F = (coordinatesAtK t F).map ofK`), by the kernel (`basis18_check_*`); hence
  `coordinateFunctionalsBasis_18` and `coordinatesAt_pointE_18`.
-/

namespace UniComplete.Domain

open LeanVM.Parameters UniStatement

/-! ### The elimination as a fold of column steps -/

/-- The starting matrix `[M | I]`, `M[j][m] = β_j^(2^m)` (`coordinateFunctionals`' `rows`). -/
def gjInit (r : ℕ) : Array (Array K) :=
  Array.ofFn (n := r) fun j ↦
    (Array.ofFn (n := r) fun mm ↦ frobK (beta.getD j.val 0) mm.val) ++
      Array.ofFn (n := r) fun c ↦ if c.val = j.val then (1 : K) else 0

/-- **One column step** of `coordinateFunctionals`' Gauss–Jordan: its loop body, verbatim. -/
def gjStep (r col : ℕ) (rows : Array (Array K)) : Array (Array K) := Id.run do
  let mut rows := rows
  let pivot := ((List.range' col (r - col)).find? fun i ↦
    (rows.getD i #[]).getD col 0 ≠ 0).getD col
  let rowCol := rows.getD col #[]
  let rowPivot := rows.getD pivot #[]
  rows := (rows.set! col rowPivot).set! pivot rowCol
  let inverse := ((rows.getD col #[]).getD col 0)⁻¹
  rows := rows.set! col ((rows.getD col #[]).map (· * inverse))
  for i in [0:r] do
    let factor := (rows.getD i #[]).getD col 0
    if i ≠ col ∧ factor ≠ 0 then
      let pivotRow := rows.getD col #[]
      rows := rows.set! i ((rows.getD i #[]).zipWith (fun x p ↦ x + factor * p) pivotRow)
  return rows

/-- The column steps `c, …, c + k − 1`. -/
def gjSteps (r c k : ℕ) (rows : Array (Array K)) : Array (Array K) :=
  (List.range' c k).foldl (fun rows col ↦ gjStep r col rows) rows

/-- The functionals read off the eliminated matrix (`coordinateFunctionals`' result). -/
def gjOut (r : ℕ) (rows : Array (Array K)) : Array (Array K) :=
  Array.ofFn (n := r) fun l ↦ Array.ofFn (n := r) fun mm ↦ (rows.getD mm.val #[]).getD (r + l.val) 0

/-- A `for` loop whose body always yields is a fold. -/
theorem forIn_yield_eq_foldl' {β : Type} (L : List ℕ) (init : β) (F : ℕ → β → Id (ForInStep β))
    (G : β → ℕ → β) (hF : ∀ a b, F a b = pure (ForInStep.yield (G b a))) :
    forIn L init F = (L.foldl G init : Id β) := by
  induction L generalizing init with
  | nil => rfl
  | cons a L ih =>
    rw [List.forIn_cons, hF]
    exact ih _

/-- **`coordinateFunctionals r` is the fold of its column steps.** -/
theorem coordinateFunctionals_eq_gjSteps (r : ℕ) :
    coordinateFunctionals r = gjOut r (gjSteps r 0 r (gjInit r)) := by
  unfold coordinateFunctionals
  simp only [Id.run]
  rw [Std.Legacy.Range.forIn_eq_forIn_range',
    forIn_yield_eq_foldl' _ _ _ (fun rows col ↦ gjStep r col rows) ?hF]
  · have hsize : (Std.Legacy.Range.mk 0 r 1 (by omega)).size = r := by
      simp [Std.Legacy.Range.size]
    rw [hsize]
    rfl
  · intro _ _
    rfl

/-- Cutting the columns `c, …, c + k − 1` after the first `k1`. -/
theorem gjSteps_split (r c k k1 k2 c' : ℕ) (h : k = k1 + k2) (hc : c' = c + k1) (rows : Array (Array K)) :
    gjSteps r c k rows = gjSteps r c' k2 (gjSteps r c k1 rows) := by
  subst h hc
  unfold gjSteps
  rw [← List.range'_append_1, List.foldl_append]

/-! ### Kernel-friendly products in `K` -/

/-- `BinaryField.carryLessMul` on natural numbers: the low `w` bits of the carry-less product of the low `v`
bits of `a` with `b`. -/
def clmulN (v w a b : ℕ) : ℕ :=
  (List.range v).foldl (fun acc i ↦ if a.testBit i then acc ^^^ ((b % 2 ^ w) <<< i) % 2 ^ w else acc) 0

/-- `BF64.foldStep` on natural numbers. -/
def foldN (x : ℕ) : ℕ := clmulN 64 128 ((x >>> 64) % 2 ^ 64) 0x1B ^^^ (x % 2 ^ 64) % 2 ^ 128

/-- `BF64.mul` on natural numbers. -/
def mulN (a b : ℕ) : ℕ := foldN (foldN (clmulN 64 128 a b)) % 2 ^ 64

theorem map_val_finRange (n : ℕ) : (List.finRange n).map Fin.val = List.range n := by
  apply List.ext_getElem <;> simp

theorem clmul_toNat {v w : ℕ} (a b : BitVec v) :
    (BinaryField.carryLessMul (w := w) a b).toNat = clmulN v w a.toNat b.toNat := by
  unfold BinaryField.carryLessMul clmulN
  rw [Fin.foldl_eq_foldl_finRange, ← map_val_finRange, List.foldl_map]
  suffices h : ∀ (L : List (Fin v)) (acc : BitVec w),
      (L.foldl (fun (acc : BitVec w) (i : Fin v) ↦
        if a.getLsbD (i : ℕ) then acc ^^^ (BinaryField.zeroExtendTo b <<< (i : ℕ)) else acc) acc).toNat =
      L.foldl (fun (acc : ℕ) (i : Fin v) ↦
        if a.toNat.testBit (i : ℕ) then acc ^^^ ((b.toNat % 2 ^ w) <<< (i : ℕ)) % 2 ^ w else acc) acc.toNat by
    have := h (List.finRange v) 0
    rw [show (0 : BitVec w).toNat = 0 by simp] at this
    exact this
  intro L
  induction L with
  | nil => intro acc; rfl
  | cons i L ih =>
    intro acc
    rw [List.foldl_cons, List.foldl_cons, ih]
    congr 1
    show (if a.toNat.testBit i then _ else _ : BitVec w).toNat = _
    split_ifs
    · rw [BitVec.toNat_xor, BitVec.toNat_shiftLeft, BinaryField.zeroExtendTo, BitVec.zeroExtend,
        BitVec.toNat_setWidth]
    · rfl

theorem foldStep_toNat (x : BitVec 128) : (BF64.foldStep x).toNat = foldN x.toNat := by
  unfold BF64.foldStep foldN
  rw [BitVec.toNat_xor, clmul_toNat]
  simp only [BF64.highHalf, BF64.lowHalf, BinaryField.zeroExtendTo, BitVec.zeroExtend, BitVec.toNat_setWidth,
    BitVec.toNat_ushiftRight]
  rfl

theorem mul_toNat (a b : K) : (a * b).toBitVec.toNat = mulN a.toBitVec.toNat b.toBitVec.toNat := by
  show (BF64.mul a b).toBitVec.toNat = _
  unfold BF64.mul BF64.reduce mulN
  rw [BF64.toBitVec_ofBitVec, BF64.lowHalf, BitVec.toNat_setWidth, foldStep_toNat, foldStep_toNat,
    clmul_toNat]

theorem eq_of_toNat {a b : K} (h : a.toBitVec.toNat = b.toBitVec.toNat) : a = b := by
  cases a
  cases b
  congr
  exact BitVec.eq_of_toNat_eq h

/-- **A product in `K` the kernel evaluates fast**: `mulN`, after the factors `0` and `1`. -/
def mulF (a b : K) : K :=
  if a.toBitVec.toNat = 0 then 0
  else if b.toBitVec.toNat = 0 then 0
  else if b.toBitVec.toNat = 1 then a
  else if a.toBitVec.toNat = 1 then b
  else BF64.ofBitVec (BitVec.ofNat 64 (mulN a.toBitVec.toNat b.toBitVec.toNat))

theorem mulF_eq (a b : K) : mulF a b = a * b := by
  unfold mulF
  split_ifs with h1 h2 h3 h4
  · rw [show a = 0 from eq_of_toNat (by rw [h1]; rfl), zero_mul]
  · rw [show b = 0 from eq_of_toNat (by rw [h2]; rfl), mul_zero]
  · rw [show b = 1 from eq_of_toNat (by rw [h3]; rfl), mul_one]
  · rw [show a = 1 from eq_of_toNat (by rw [h4]; rfl), one_mul]
  · apply eq_of_toNat
    rw [mul_toNat, BF64.toBitVec_ofBitVec, BitVec.toNat_ofNat, mulN, Nat.mod_mod]

/-- `a^(2^k)` on `mulF`. -/
def powTwoPowF (a : K) : ℕ → K
  | 0 => a
  | n + 1 => powTwoPowF (mulF a a) n

theorem powTwoPowF_eq (a : K) (n : ℕ) : powTwoPowF a n = BF64.powTwoPow a n := by
  induction n generalizing a with
  | zero => rfl
  | succ n ih => rw [powTwoPowF, ih, mulF_eq]; rfl

/-- **The inverse on `mulF`**: CompPoly's Itoh–Tsujii chain (`BF64.invItohTsujii`). -/
def invF (a : K) : K :=
  if a = 0 then 0 else
    let u1 := a
    let u2 := mulF (powTwoPowF u1 1) u1
    let u3 := mulF (powTwoPowF u2 1) u1
    let u6 := mulF (powTwoPowF u3 3) u3
    let u7 := mulF (powTwoPowF u6 1) u1
    let u14 := mulF (powTwoPowF u7 7) u7
    let u15 := mulF (powTwoPowF u14 1) u1
    let u30 := mulF (powTwoPowF u15 15) u15
    let u31 := mulF (powTwoPowF u30 1) u1
    let u62 := mulF (powTwoPowF u31 31) u31
    let u63 := mulF (powTwoPowF u62 1) u1
    mulF u63 u63

theorem invF_eq (a : K) : invF a = a⁻¹ := by
  show _ = BF64.invItohTsujii a
  unfold invF BF64.invItohTsujii
  simp only [mulF_eq, powTwoPowF_eq]

/-! ### The column steps on `mulF` -/

/-- `gjStep` on `mulF` and `invF`. -/
def gjStepF (r col : ℕ) (rows : Array (Array K)) : Array (Array K) := Id.run do
  let mut rows := rows
  let pivot := ((List.range' col (r - col)).find? fun i ↦
    (rows.getD i #[]).getD col 0 ≠ 0).getD col
  let rowCol := rows.getD col #[]
  let rowPivot := rows.getD pivot #[]
  rows := (rows.set! col rowPivot).set! pivot rowCol
  let inverse := invF ((rows.getD col #[]).getD col 0)
  rows := rows.set! col ((rows.getD col #[]).map (mulF · inverse))
  for i in [0:r] do
    let factor := (rows.getD i #[]).getD col 0
    if i ≠ col ∧ factor ≠ 0 then
      let pivotRow := rows.getD col #[]
      rows := rows.set! i ((rows.getD i #[]).zipWith (fun x p ↦ x + mulF factor p) pivotRow)
  return rows

theorem gjStep_eq_F (r col : ℕ) (rows : Array (Array K)) : gjStep r col rows = gjStepF r col rows := by
  simp only [gjStep, gjStepF, mulF_eq, invF_eq]

/-- `gjSteps` on `gjStepF`. -/
def gjStepsF (r c k : ℕ) (rows : Array (Array K)) : Array (Array K) :=
  (List.range' c k).foldl (fun rows col ↦ gjStepF r col rows) rows

theorem gjSteps_eq_F (r c k : ℕ) (rows : Array (Array K)) : gjSteps r c k rows = gjStepsF r c k rows := by
  simp only [gjSteps, gjStepsF, gjStep_eq_F]

/-- `frobK` on `mulF`. -/
def frobKF (x : K) : ℕ → K
  | 0 => x
  | m + 1 => frobKF (mulF x x) m

theorem frobKF_eq (x : K) (m : ℕ) : frobKF x m = frobK x m := by
  induction m generalizing x with
  | zero => rfl
  | succ m ih => rw [frobKF, ih, mulF_eq]; rfl

/-- `gjInit` on `frobKF`. -/
def gjInitF (r : ℕ) : Array (Array K) :=
  Array.ofFn (n := r) fun j ↦
    (Array.ofFn (n := r) fun mm ↦ frobKF (beta.getD j.val 0) mm.val) ++
      Array.ofFn (n := r) fun c ↦ if c.val = j.val then (1 : K) else 0

theorem gjInit_eq_F (r : ℕ) : gjInit r = gjInitF r := by
  simp only [gjInit, gjInitF, frobKF_eq]

/-! ### Words -/

/-- A matrix of `K` from its words. -/
def ofWords (W : List (List UInt64)) : Array (Array K) := (W.map fun row ↦ (row.map K.ofLane).toArray).toArray

/-- The words of a matrix of `K`. -/
def toWords (a : Array (Array K)) : List (List UInt64) := a.toList.map fun row ↦ row.toList.map K.lane

theorem ofLane_lane (x : K) : K.ofLane (K.lane x) = x := rfl

theorem eq_ofWords {a : Array (Array K)} {W : List (List UInt64)} (h : toWords a = W) : a = ofWords W := by
  subst h
  simp [ofWords, toWords, List.map_map, Function.comp_def, ofLane_lane]

