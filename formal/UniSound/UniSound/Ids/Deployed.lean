theorem cfFold10 : (List.range 10).foldl (cfStep 18) (cfInit 18) = mat cfMat10 :=
  (cfFold_succ 9).trans ((congrArg (cfStep 18 · 9) cfFold9).trans cfStep9)

theorem cfFold11 : (List.range 11).foldl (cfStep 18) (cfInit 18) = mat cfMat11 :=
